# Docker Compose configuration. The setup script (setup.ps1 / setup.sh) copies this
# to .env, picks free host ports and generates secrets automatically.

# Host ports (if a port is taken, the setup script uses the next free one)
APP_PORT=8080
BACKEND_PORT=8000
DB_FORWARD_PORT=3306
MAILPIT_PORT=8025

# Network of the stack. nginx has a fixed address so that Laravel can trust exactly that
# proxy. Change both values together if the subnet clashes with another network.
DOCKER_SUBNET=10.213.47.0/24
FRONTEND_IP=10.213.47.10

# Laravel application key (base64:...)
APP_KEY=

# Detailed error pages expose code and data. Set to true only while debugging locally.
APP_DEBUG=false

# MySQL
DB_DATABASE=shop
DB_USERNAME=shop
DB_PASSWORD=shop_secret
DB_ROOT_PASSWORD=root_secret

# Mail goes to the Mailpit container; nothing leaves the machine.
MAIL_FROM_ADDRESS=sklep@example.com

# Admin account, created by `php artisan shop:admin`. The setup script generates the
# password on the first run and keeps it afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Shop contact details shown in the frontend. Contact form messages go to the email.
SHOP_CONTACT_EMAIL=kontakt@sklep.example
SHOP_CONTACT_PHONE=+48 000 000 000
SHOP_CONTACT_ADDRESS=ul. Przykładowa 1, 00-001 Warszawa
SHOP_CONTACT_HOURS=pon.-pt. 9:00-17:00
